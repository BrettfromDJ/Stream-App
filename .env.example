# ── Supabase (database + auth) ─────────────────────────────────────────────
# Supabase dashboard → Project Settings → API (or "Connect" → App Frameworks → Next.js)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The "publishable" key (sb_publishable_…). The legacy "anon" key also works.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ── TMDB (movies + TV) — server only ───────────────────────────────────────
# themoviedb.org → Settings → API. Paste the "API Read Access Token" (preferred) or the v3 "API Key".
TMDB_API_KEY=

# ── IGDB (games) — server only ─────────────────────────────────────────────
# IGDB is run by Twitch: dev.twitch.tv/console → Register Your Application
# (OAuth Redirect URL: http://localhost, Category: Application Integration, Client Type: Confidential)
# then copy the Client ID and generate a Client Secret.
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# ── Hardcover (books) — server only ────────────────────────────────────────
# hardcover.app → Settings → API (hardcover.app/account/api). Copy the token.
# Optional: without it, books come from Open Library.
HARDCOVER_API_TOKEN=

# ── New York Times Books API (bestseller charts) — server only, optional ──
# developer.nytimes.com → Apps → New App → enable "Books API" → copy the key.
NYT_API_KEY=

# ── Optional ───────────────────────────────────────────────────────────────
# Contact info sent in the User-Agent to Open Library (they ask apps to identify themselves).
OPENLIBRARY_CONTACT=
# Canonical site URL for auth email links. Defaults to the current request host.
NEXT_PUBLIC_SITE_URL=

# ── OMDb (Rotten Tomatoes / IMDb / Metacritic scores) — server only, optional ──
# omdbapi.com/apikey.aspx → choose FREE → confirm the email → copy the key.
OMDB_API_KEY=
